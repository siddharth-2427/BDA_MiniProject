# General Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Hadoop & Spark Ports
HADOOP_NAMENODE_PORT=9000
HADOOP_NAMENODE_UI_PORT=9870
HADOOP_DATANODE_PORT=9864
YARN_RESOURCEMANAGER_PORT=8088
HIVE_SERVER2_PORT=10000
